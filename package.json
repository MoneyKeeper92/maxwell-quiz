{
  "name": "free-practice-questions",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-meta.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "import-quiz": "sh -c 'PY=$(ls ../venv/bin/python 2>/dev/null || command -v python3); \"$PY\" scripts/import_quiz.py \"$@\"' --",
    "gen-registry": "sh -c 'PY=$(ls ../venv/bin/python 2>/dev/null || command -v python3); \"$PY\" scripts/gen_registry.py'",
    "qc": "sh -c 'PY=$(ls ../venv/bin/python 2>/dev/null || command -v python3); \"$PY\" scripts/qc.py \"$@\"' --",
    "audit": "sh -c 'PY=$(ls ../venv/bin/python 2>/dev/null || command -v python3); \"$PY\" scripts/audit.py \"$@\"' --",
    "normalize-cpa": "sh -c 'PY=$(ls ../venv/bin/python 2>/dev/null || command -v python3); \"$PY\" scripts/normalize_cpa_html.py \"$@\"' --",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^25.0.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^2.1.9"
  }
}
