# Netlify: Project configuration -> Environment variables.
# Both are build-time (Vite inlines VITE_* at build), so redeploy after changing.
# Without them the app still runs; tracking and the report button stay off.
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
